# DeepSeek。请复制为 .env 并填入本地密钥，勿提交 .env。
DEEPSEEK_API_KEY=
FINRISK_LLM_BASE_URL=https://api.deepseek.com
FINRISK_LLM_MODEL=deepseek-v4-flash
FINRISK_LLM_THINKING=disabled
FINRISK_LLM_CONNECT_TIMEOUT=10
FINRISK_LLM_READ_TIMEOUT=90

# 可选路径覆盖；默认值已指向项目内的统一案例库和上传目录。
