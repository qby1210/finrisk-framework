.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
*.log
*.zip

# 采集台账（state/ingested）随仓库分发，避免全新部署重复入库已采集案
data/raw/cases/*
!data/raw/cases/crawl/
!data/raw/cases/crawl/**
data/raw/query/*
!data/raw/query/query_test_set_160.json
!data/raw/query/query_dev_set.json
!data/raw/query/query_long_tail_enhancement.json
data/interim/
data/processed/cases/
!data/**/.gitkeep

# 统一案例库是运行必需数据，不能被 processed 通配规则排除。
# 仓库只携带当前版本（08-23）；历史版本本地保留用于回滚，不进 git。
data/processed/knowledge/*
!data/processed/knowledge/case_kb_v2_1_2026-08-23/
!data/processed/knowledge/case_kb_v2_1_2026-08-23/**

models/
checkpoints/
